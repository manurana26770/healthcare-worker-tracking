{
  "name": "healthcare-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend foundation for healthcare-app migration",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "echo \"lint not configured yet\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:auth": "jest --runInBand test/auth.parity.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "joi": "^17.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.1",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "prisma": "^6.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18"
  }
}
